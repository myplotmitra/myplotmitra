      },
      "dest": "/firebase-messaging-sw.js"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/"
      },
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/api/use-credit",
      "dest": "/api/contacts.js?__mpm_route=use-credit"
    },
    {
      "src": "/api/contact-request",
      "dest": "/api/contacts.js?__mpm_route=contact-request"
    },
    {
      "src": "/api/property-contact",
      "dest": "/api/contacts.js?__mpm_route=property-contact"
    },
    {
      "src": "/api/notify",
      "dest": "/api/notify.js"
    },
    {
      "src": "/_vercel/insights/(.*)",
      "dest": "/_vercel/insights/$1"
    },
    {
      "src": "/api/my-properties",
      "dest": "/api/properties.js?__mpm_route=my-properties"
    },
    {
      "src": "/api/property-update",
      "dest": "/api/properties.js?__mpm_route=property-update"
    },
    {
      "src": "/api/property-mark-sold",
      "dest": "/api/properties.js?__mpm_route=property-mark-sold"
    },
    {
      "src": "/api/r2-delete-property",
      "dest": "/api/properties.js?__mpm_route=r2-delete-property"
    },
    {
      "src": "/api/property-create",
      "dest": "/api/properties.js?__mpm_route=property-create"
    },
    {
      "src": "/api/r2-upload-url",
      "dest": "/api/r2.js?__mpm_route=r2-upload-url"
    },
    {
      "src": "/api/r2-finalize-upload",
      "dest": "/api/r2.js?__mpm_route=r2-finalize-upload"
    },
    {
      "src": "/api/r2-cleanup-uploads",
      "dest": "/api/r2.js?__mpm_route=r2-cleanup-uploads"
    },
    {
      "src": "/api/rental-draft-create",
      "dest": "/api/properties.js?__mpm_route=rental-draft-create"
    },
    {
      "src": "/api/cashfree-create-order",
      "dest": "/api/cashfree-create-order.js"
    },
    {
      "src": "/api/cashfree-verify",
      "dest": "/api/cashfree-verify.js"
    },
    {
      "src": "/api/cashfree-webhook",
      "dest": "/api/cashfree-webhook.js"
    },
    {
      "src": "/api/admin-social-promotion",
      "dest": "/api/admin-social-promotion.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
